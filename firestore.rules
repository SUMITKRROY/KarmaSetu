rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Helper Functions
    // =========================================================================

    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user is operating on their own document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Fetch user profile from the 'users' collection
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Check if user has an Approver or Manager role
    function isApprover() {
      return isAuthenticated() && (
        getUserData().role.lower() == 'approver' ||
        getUserData().role.lower() == 'manager' ||
        getUserData().role.lower() == 'admin'
      );
    }

    // Check if user has Admin role
    function isAdmin() {
      return isAuthenticated() && getUserData().role.lower() == 'admin';
    }

    // =========================================================================
    // 1. Users Collection
    // =========================================================================
    match /users/{userId} {
      // Authenticated users can read profile details
      allow read: if isAuthenticated();

      // Users can create their own profile during registration; Approvers/Admins can provision
      allow create: if isAuthenticated() && (request.auth.uid == userId || isApprover() || isAdmin());

      // Users can update their own profile; Admins can update any profile
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());

      // Only admins can delete user records
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 2. Leaves Collection (Leave Requests & Approvals)
    // =========================================================================
    match /Leaves/{leaveId} {
      // READ: Employees can read their own leave requests;
      // Approvers, Managers, and Admins can read all leave requests to review them.
      allow read: if isAuthenticated() && (
        resource.data.uid == request.auth.uid || isApprover()
      );

      // CREATE: Employees can submit new leave requests with their own uid;
      // Approvers/Admins can also submit.
      allow create: if isAuthenticated() && (
        request.resource.data.uid == request.auth.uid || isApprover()
      );

      // UPDATE (APPROVE / REJECT):
      // - Approvers / Managers / Admins have full permission to approve, reject,
      //   and add remarks/reasons to any leave request.
      // - Employees can update or modify their own pending requests.
      allow update: if isAuthenticated() && (
        isApprover() || (resource.data.uid == request.auth.uid && resource.data.status == 'Pending')
      );

      // DELETE:
      // Approvers/Admins or the owner if the leave is still pending.
      allow delete: if isAuthenticated() && (
        isApprover() || (resource.data.uid == request.auth.uid && resource.data.status == 'Pending')
      );
    }

    // =========================================================================
    // 3. Attendance Collection
    // =========================================================================
    match /Attendance/{attendanceId} {
      // READ: Employees can read their own punches; Approvers can read all punches for reports
      allow read: if isAuthenticated() && (
        resource.data.uid == request.auth.uid || isApprover()
      );

      // CREATE (PUNCH IN): Users can create attendance records for their own uid
      allow create: if isAuthenticated() && (
        request.resource.data.uid == request.auth.uid || isApprover()
      );

      // UPDATE (PUNCH OUT): Users can update check-out on their own attendance
      allow update: if isAuthenticated() && (
        resource.data.uid == request.auth.uid || isApprover()
      );

      allow delete: if isAdmin();
    }
  }
}
